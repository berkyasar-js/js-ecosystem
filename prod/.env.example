# Bos birakilirsa uygulama DEMO modunda calisir (veritabani gerekmez).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sunucu tarafi (asla NEXT_PUBLIC_ yapma)
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Webhook HMAC-SHA256 imza anahtari
JSCORE_WEBHOOK_SECRET=
# Demo modunda /api/mcp icin Bearer token (varsayilan: jsdemo_token)
DEMO_MCP_TOKEN=
# Aylik ajan maliyet tavani env degil, organizasyon ayaridir: Admin > Yapay zeka (settings.ai.monthly_cap_usd, 0 = tavan yok; kur: settings.ai.usd_try)
# Vercel Cron -> GET /api/events/dispatch (otomasyon olay isleyici). Tanimliysa Vercel 'Authorization: Bearer <CRON_SECRET>' gonderir.
CRON_SECRET=
# Trello (opsiyonel): Power-Up "API secret" (OAuth secret). Tanimliysa /api/webhooks/trello x-trello-webhook (HMAC-SHA1) imzasini zorunlu kilar; yoksa webhook URL'indeki gizli 'k' parametresi kullanilir. API Key/Token env degil: Connect > Trello formundan girilir, sunucuda integrations.config'e yazilir.
TRELLO_API_SECRET=
# Webhook callback adresi icin herkese acik HTTPS taban URL (verilmezse istek basliklarindan cikarilir)
APP_URL=

# ── Ana Yonetim Paneli (apps/admin) ──
# Admin ayni Supabase degiskenlerini kullanir (NEXT_PUBLIC_SUPABASE_URL/ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY).
# Kullanici uygulamasinin (apps/web) herkese acik HTTPS adresi: davet/parola e-postalarinin donus adresi ve Trello webhook callback tabani.
NEXT_PUBLIC_APP_URL=
# apps/web icin: Ana Yonetim Paneli adresi ("Bu alan Ana Yonetim Paneli'ne tasindi" bildirimindeki baglanti)
NEXT_PUBLIC_ADMIN_URL=
