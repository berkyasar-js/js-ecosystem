# Bos birakilirsa uygulama DEMO modunda calisir (veritabani gerekmez).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sunucu tarafi (asla NEXT_PUBLIC_ yapma)
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Webhook HMAC-SHA256 imza anahtari
JSCORE_WEBHOOK_SECRET=
# Demo modunda /api/mcp icin Bearer token (varsayilan: jsdemo_token)
DEMO_MCP_TOKEN=
# Aylik ajan maliyet tavani env degil, organizasyon ayaridir: Admin > Yapay zeka (settings.ai.monthly_cap_usd, 0 = tavan yok; kur: settings.ai.usd_try)
# Vercel Cron -> GET /api/events/dispatch (otomasyon olay isleyici). Tanimliysa Vercel 'Authorization: Bearer <CRON_SECRET>' gonderir.
CRON_SECRET=
